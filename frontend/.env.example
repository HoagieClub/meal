# === Auth0 ===
# Secret for signing session cookies. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Where users land after login, e.g. http://localhost:3000
AUTH0_BASE_URL=
# Auth0 tenant, e.g. https://hoagie.us.auth0.com
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# API identifier the issued tokens are for.
AUTH0_AUDIENCE=
# e.g. openid profile offline_access
AUTH0_SCOPE=

# === Backend ===
# URL of the Django API. HOAGIE_API_URL is read server-side by the proxy routes;
# NEXT_PUBLIC_HOAGIE_API_URL is read in the browser for menu requests. Usually the same value.
HOAGIE_API_URL=
NEXT_PUBLIC_HOAGIE_API_URL=
